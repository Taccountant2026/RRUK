# Configure production values with Sites runtime environment variables.
# Never commit actual credentials or put them in NEXT_PUBLIC_* variables.
ADMIN_EMAIL=owner@example.com
PUBLIC_ORIGIN=https://your-verified-site-origin.example
STORE_SECRET=generate-a-random-secret-of-at-least-48-bytes
SITE_INDEXABLE=false
# Stripe keys are entered through the authenticated /admin Payments form.
# They are encrypted in D1 using STORE_SECRET, never stored in this file.
